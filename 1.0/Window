    private void jButtonSelsectFileActionPerformed(java.awt.event.ActionEvent evt) {                                                   
        // TODO add your handling code here:

        JFileChooser chooser = new JFileChooser();
        chooser.setFileSelectionMode(JFileChooser.FILES_ONLY);
        chooser.setMultiSelectionEnabled(true);
        int result = chooser.showOpenDialog(null);

        if (result == JFileChooser.APPROVE_OPTION) {
            // Clear the text area before adding new file names
            fileList = new LinkedList<>();
            ShowFiles_jTextArea.setText("");

            for (File f : chooser.getSelectedFiles()) {
                String fileName = f.getName();
                fileList.add(fileName);
                ShowFiles_jTextArea.append(fileName + "\n");
            }
            showFileContent();
            makeTree();
        }
    }                                                  

    private void orderType_jComboBoxActionPerformed(java.awt.event.ActionEvent evt) {                                                    
        // TODO add your handling code here:
        String selectedOrder = (String) orderType_jComboBox.getSelectedItem();
        if (bst != null) {
            switch (selectedOrder) {
                case "pre-order":
                    result_jTextArea.setText("Pre-order traversal:\n");
                    bst.preorder(result_jTextArea);
                    break;
                case "in-order":
                    result_jTextArea.setText("In-order traversal:\n");
                    bst.inorder(result_jTextArea);
                    break;
                case "post-order":
                    result_jTextArea.setText("Post-order traversal:\n");
                    bst.postorder(result_jTextArea);
                    break;
                default:
                    break;
            }
        } else {
            result_jTextArea.setText("Tree is Empty");
        }

    }                                                   

