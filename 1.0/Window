    private void readIgnoreListFromFile(String filePath) {
        try ( BufferedReader br = new BufferedReader(new FileReader(filePath))) {
            String line;
            while ((line = br.readLine()) != null) {
                ignoreList.add(line);
            }
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    private void showFileContent() {
        showText_jTextArea.setText("");
        
        LinkedList.ListNode<String> current = fileList.head;
        while (current != null) {
            String fileName = current.data;
            String filePath = fileName;
            try ( BufferedReader br = new BufferedReader(new FileReader(filePath))) {
                showText_jTextArea.append("\nFile: " + fileName + "\n");

                StringBuilder fileContentBuilder = new StringBuilder();
                String line;
                while ((line = br.readLine()) != null) {
                    fileContentBuilder.append(line).append(" ");
                }
                String fileContent = fileContentBuilder.toString();

                showText_jTextArea.append(fileContent);
                showText_jTextArea.append("\n");

            } catch (IOException e) {
                e.printStackTrace();
            }
            current = current.next;
        }
    }

    private void makeTree() {
        bst = new BST();
        
        ignoreList = new ArrayList<>();
        readIgnoreListFromFile("ignoreList.txt");
        ignoreList.add("\\<.*?\\>");
        ignoreList.add("[^a-zA-Z\\s]");
        
        LinkedList.ListNode<String> temp = fileList.head;
        while (temp != null) {
            String fileName = temp.data;
            String filePath = fileName;

            try ( BufferedReader br = new BufferedReader(new FileReader(filePath))) {
                StringBuilder fileContentBuilder = new StringBuilder();
                String line;
                while ((line = br.readLine()) != null) {
                    fileContentBuilder.append(line).append("\n");
                }
                String fileContent = fileContentBuilder.toString();

                String newWord = "";
                boolean inTag = false; // Flag to indicate if currently inside a tag
                for (int i = 0; i < fileContent.length(); i++) {
                    char currentChar = fileContent.charAt(i);

                    if (currentChar == '<') {
                        inTag = true;
                        continue;
                    } else if (currentChar == '>') {
                        inTag = false;
                        continue;
                    }

                    
                    if (!inTag && Character.isLetter(currentChar)) {
                        newWord += currentChar;
                    } else {
                        if (!newWord.isEmpty() && !ignoreList.contains(newWord.trim())) {
                            bst.insert(newWord);
                        }
                        newWord = "";
                    }
                }
                //the last word
                if (!newWord.isEmpty() && !ignoreList.contains(newWord.trim())) {
                    bst.insert(newWord.trim());
                }

            } catch (IOException e) {
                e.printStackTrace();
            }
            temp = temp.next;
        }
    }

